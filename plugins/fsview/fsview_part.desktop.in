[Desktop Entry]
Name=File Size View
Name[ru]=Просмотр размеров файлов
Comment=Enables a proportional view of directories and files based on file size
Comment[ru]=Включает отображение каталогов и файлов пропорционально их размеру
MimeType=inode/directory;
ServiceTypes=KParts/ReadOnlyPart
X-KDE-Library=kf5/parts/fsviewpart
Type=Service
Icon=fsview
DocPath=konq-plugins/fsview/index.html

X-KDE-PluginInfo-Name=fsviewpart
X-KDE-PluginInfo-Version=@fsview_VERSION@
